/evaluate/results

# System Files
.DS_Store
Thumbs.db

# AI Auto Generated Docs
docs/ai_plans/
.docuvia/
graphify-out/

# Sibling/competitor product indexes (only appear if their CLI is run
# directly against this tree — should normally be run from a git worktree instead)
.gitnexus/
.code-review-graph/

# Compiled TypeScript js files in source folders
lib/core/src/**/*.js
lib/schema/src/**/*.js

# Dev-mode-compiled AST worker (see ast-worker-pool.ts's compileWorkerForDevMode()) — a
# still-being-written temp file, renamed atomically once complete.
lib/core/src/**/*.js.*.tmp

# Harness Everything Skill output (only appears if the skill is installed and run directly against this tree — should normally be run from a git worktree instead)
.github/harness-everything/
.claude/harness-everything/
.cursor/harness-everything/
.codex/harness-everything/
.continue/harness-everything/
