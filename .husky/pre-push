# Unset the git env vars git exports into this hook so spawned `git`/test processes operate on
# their own cwd rather than inheriting the parent repo's GIT_DIR / GIT_INDEX_FILE. Otherwise the
# full test suite run here fails on the git-spawning integration tests (init / uninstall /
# doctor). Let git rediscover the repo from cwd via core.hooksPath discovery.
unset GIT_DIR GIT_INDEX_FILE GIT_OBJECT_DIRECTORY GIT_ALTERNATE_OBJECT_DIRECTORIES GIT_COMMON_DIR GIT_WORK_TREE GIT_QUARANTINE_PATH 2>/dev/null || true

# Skip the lint/typecheck/build/test/quality-gate below when every ref in this push is a
# deletion (e.g. `git push origin --delete branch1 branch2`) -- there's no new code to verify,
# and the ~3min suite only adds flake risk (e.g. hookTimeout-sensitive LSP preflight tests) for
# zero benefit. Git feeds pre-push one line per ref on stdin: "<local ref> <local sha1> <remote
# ref> <remote sha1>"; a delete is marked by local sha1 = all-zeros. A push that mixes commits
# with deletions still runs the full gate below.
zero_sha="0000000000000000000000000000000000000000"
delete_only=1
while read -r local_ref local_sha remote_ref remote_sha; do
  if [ "$local_sha" != "$zero_sha" ]; then
    delete_only=0
  fi
done

if [ "$delete_only" = "1" ]; then
  echo "Push is branch deletion(s) only -- skipping lint/typecheck/build/test/quality-gate."
else
  echo "Running lint and complexity budget checks (fail-fast)..."
  pnpm run lint

  echo "Running full typecheck..."
  pnpm run typecheck

  echo "Running full build..."
  pnpm run build

  echo "Running full test suite and global coverage..."
  pnpm run test

  echo "Running test quality gate..."
  bash scripts/test-quality-gate.sh
fi
#!/bin/bash
# Docuvia Tier B Batch Hook (LSP escalation + snapshot + knowledge sync)
# Runs synchronously (generous timeout) so pushed code carries corrected knowledge -- see
# docs/gitbook/analysis/phase1-decision-integration.md §8h and
# docs/gitbook/analysis/phase2-sync-knowledge-scheduling.md.
if command -v npx > /dev/null 2>&1; then
  npx --no-install docuvia hooks check tier-b-c-prepush && npx --no-install docuvia analyze --escalate-to-lsp --fallback-ast && npx --no-install docuvia snapshot && npx --no-install docuvia sync-knowledge
fi
# Never blocks the push on a Tier B/sync-knowledge failure -- PLAT-007's reliability
# requirement (failures only ever surface via JSONL logs / doctor, never to the pushing
# developer).
exit 0
