{
  "name": "@workspace/cli",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "bin": {
    "docuvia": "./src/cli.ts"
  },
  "scripts": {
    "hello": "tsx ./src/hello.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --fileParallelism false",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:smoke": "vitest run test/integration/cli.args.test.ts",
    "test:unit": "vitest run test/unit",
    "test:integration": "vitest run test/integration"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "catalog:",
    "@vitest/ui": "^1.6.1",
    "c8": "^11.0.0",
    "execa": "^9.6.1",
    "pino-pretty": "^13",
    "tsx": "catalog:",
    "vitest": "^1.6.1"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.5.2",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@workspace/core": "workspace:^",
    "@workspace/db": "workspace:^",
    "better-sqlite3": "^12.11.1",
    "cli-table3": "^0.6.5",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "ora": "^9.4.1",
    "picocolors": "^1.1.1"
  }
}
