{
  "name": "@workspace/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts",
    "./schema/pg": "./src/schema/pg/index.ts",
    "./schema/sqlite": "./src/schema/sqlite/index.ts",
    "./schema/shared": "./src/schema/shared/graph.ts"
  },
  "scripts": {
    "push": "drizzle-kit push --config ./drizzle.config.cjs",
    "push-force": "drizzle-kit push --force --config ./drizzle.config.cjs",
    "migrate": "tsx src/migrate.ts",
    "build": "tsc -b"
  },
  "dependencies": {
    "drizzle-orm": "^0.36.0",
    "drizzle-zod": "^0.5.1",
    "pg": "^8.20.0",
    "pino": "^10.3.1",
    "postgres": "^3.4.9",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "catalog:",
    "@types/pg": "^8.18.0",
    "better-sqlite3": "^12.11.1",
    "drizzle-kit": "^0.31.9",
    "tsx": "^4.22.4",
    "vitest": "^1.0.0"
  }
}
