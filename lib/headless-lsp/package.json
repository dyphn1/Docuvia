{
  "name": "@workspace/headless-lsp",
  "version": "1.0.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc -w",
    "typecheck": "tsc --noEmit",
    "lint": "prettier --check \"src/**/*.ts\"",
    "format": "prettier --write \"src/**/*.ts\""
  },
  "dependencies": {
    "@workspace/ast-core": "workspace:^",
    "@workspace/plugins-ast": "workspace:^"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "^5.7.3"
  }
}
