{
  "name": "docuvia2",
  "version": "0.0.0",
  "lint-staged": {
    "*.ts": [
      "prettier --write",
      "vitest related --run --passWithNoTests --testTimeout=120000 --hookTimeout=120000"
    ],
    "*.{js,json,md,yml,yaml}": "prettier --write --ignore-unknown"
  },
  "license": "MIT",
  "packageManager": "pnpm@9.15.9",
  "private": true,
  "scripts": {
    "build": "pnpm run typecheck && pnpm -r --if-present run build",
    "typecheck": "tsc --build",
    "lint": "eslint .",
    "test": "rimraf coverage && vitest run --coverage --testTimeout=120000 --hookTimeout=120000",
    "eval:impact": "vitest run artifacts/cli/test/integration/commands/impact-eval.phase6.integration.test.ts artifacts/cli/test/support/impact-eval-scorer.phase6.unit.test.ts --testTimeout=240000 --hookTimeout=240000",
    "eval:impact:honesty": "vitest run --mode phase4-honesty artifacts/cli/test/integration/commands/impact-honesty-report.phase4.integration.test.ts --testTimeout=600000 --hookTimeout=600000",
    "format": "prettier --write .",
    "prepare": "husky",
    "eval:semantic": "tsx scripts/semantic-corpus-audit.mts",
    "eval:semantic:collect": "tsx scripts/semantic-corpus/collect.mts",
    "eval:semantic:system1-export": "node --import tsx scripts/semantic-corpus/system1-export.mts",
    "eval:semantic:system1-eval": "node --import tsx scripts/semantic-corpus/system1-eval.mts --final-evaluation",
    "eval:semantic:replay": "tsx scripts/semantic-corpus/replay.mts",
    "eval:semantic:baseline": "tsx scripts/semantic-corpus/baseline.mts"
  },
  "devDependencies": {
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/git": "^11.0.1",
    "@vitest/coverage-v8": "^1.0.0",
    "docuvia": "workspace:^",
    "eslint": "^10.7.0",
    "husky": "^9.1.7",
    "js-yaml": "^5.2.1",
    "lint-staged": "^17.0.8",
    "prettier": "^3.8.1",
    "rimraf": "^6.1.3",
    "semantic-release": "^25.0.9",
    "tsx": "^4.23.0",
    "typescript": "catalog:",
    "typescript-eslint": "^8.64.0",
    "typescript-language-server": "^5.3.0",
    "vitest": "^1.6.1"
  }
}
