{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "preinstall": "node ./scripts/preinstall.mjs",
    "build": "pnpm run typecheck && pnpm -r --if-present run build",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --if-present run typecheck",
    "lint": "prettier --check .",
    "format": "prettier --write .",
    "test": "node scripts/ensure-db.mjs && pnpm --filter @workspace/api-server run test",
    "test:coverage": "node scripts/ensure-db.mjs && pnpm --filter @workspace/api-server run test:coverage",
    "test:ci": "docker compose -f docker-compose.ci.yml up --build --abort-on-container-exit --exit-code-from ci-runner",
    "test:act": "docker compose -f docker-compose.act.yml run --rm act-cli act"
  },
  "private": true,
  "devDependencies": {
    "@types/supertest": "^7.2.0",
    "@vitest/coverage-v8": "^1.0.0",
    "js-yaml": "^4.1.1",
    "msw": "^2.14.6",
    "playwright": "^1.60.0",
    "prettier": "^3.8.1",
    "supertest": "^6.3.3",
    "typescript": "~5.9.2"
  },
  "dependencies": {
    "tsx": "^4.22.4"
  }
}
