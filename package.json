{
  "name": "docuvia2",
  "version": "0.0.0",
  "lint-staged": {
    "*.ts": [
      "prettier --write",
      "vitest related --run --passWithNoTests --testTimeout=30000"
    ],
    "*.{js,json,md,yml,yaml}": "prettier --write --ignore-unknown"
  },
  "license": "MIT",
  "packageManager": "pnpm@9.15.9",
  "private": true,
  "scripts": {
    "build": "pnpm run typecheck && pnpm -r --if-present run build",
    "typecheck": "tsc --build",
    "lint": "eslint .",
    "test": "rimraf coverage && vitest run --coverage --testTimeout=30000",
    "eval:impact": "vitest run artifacts/cli/test/integration/commands/impact-eval.integration.test.ts",
    "format": "prettier --write .",
    "prepare": "husky"
  },
  "devDependencies": {
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/git": "^11.0.1",
    "@vitest/coverage-v8": "^1.0.0",
    "docuvia": "workspace:^",
    "eslint": "^10.7.0",
    "husky": "^9.1.7",
    "js-yaml": "^5.2.1",
    "lint-staged": "^17.0.8",
    "prettier": "^3.8.1",
    "rimraf": "^6.1.3",
    "semantic-release": "^25.0.9",
    "tsx": "^4.23.0",
    "typescript": "catalog:",
    "typescript-eslint": "^8.64.0",
    "typescript-language-server": "^5.3.0",
    "vitest": "^1.6.1"
  }
}
