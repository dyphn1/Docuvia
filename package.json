{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "preinstall": "node ./scripts/preinstall.mjs",
    "build": "pnpm run typecheck && pnpm -r --if-present run build",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --if-present run typecheck",
    "lint": "prettier --check .",
    "format": "prettier --write .",
    "test": "node scripts/ensure-db.mjs && vitest run",
    "test:coverage": "node scripts/ensure-db.mjs && vitest run --coverage",
    "test:smoke": "node scripts/ensure-db.mjs && vitest run --project node-backend -t '@smoke'",
    "test:ci": "docker compose -f docker-compose.ci.yml up --build --abort-on-container-exit --exit-code-from ci-runner",
    "test:act": "docker compose -f docker-compose.act.yml run --rm act-cli act",
    "prepare": "husky"
  },
  "private": true,
  "devDependencies": {
    "@types/supertest": "^7.2.0",
    "@vitest/coverage-v8": "^1.0.0",
    "husky": "^9.1.7",
    "js-yaml": "^4.1.1",
    "lint-staged": "^17.0.8",
    "msw": "^2.14.6",
    "playwright": "^1.60.0",
    "prettier": "^3.8.1",
    "supertest": "^6.3.3",
    "typescript": "~5.9.2",
    "vitest": "^1.6.1"
  },
  "dependencies": {
    "@faker-js/faker": "8.4.0",
    "pg": "^8.20.0",
    "tsx": "^4.22.4"
  },
  "lint-staged": {
    "*": "prettier --write --ignore-unknown"
  }
}
